  "content_html": "<!-- Page Header -->\n        <div style=\"text-align: center; margin-bottom: 48px;\">\n            <h1 class=\"page-title\" style=\"font-size: clamp(36px, 5vw, 64px);\">UPP</h1>\n            <p style=\"font-size: 18px; color: var(--text-mid);\">Unit Peperiksaan dan Penilaian</p>\n            <div style=\"width: 80px; height: 4px; background: var(--purple); margin: 16px auto 0; border-radius: 4px;\"></div>\n        </div>\n\n        <!-- Google Drive Folder Embed -->\n        <div style=\"max-width: 1000px; margin: 0 auto;\">\n            <div style=\"background: var(--white); border-radius: 16px; overflow: hidden; border: 1px solid var(--mid-gray); box-shadow: 0 4px 16px rgba(0,0,0,0.06);\">\n                <div style=\"padding: 16px 24px; background: var(--light-gray); border-bottom: 1px solid var(--mid-gray); display: flex; align-items: center; justify-content: space-between;\">\n                    <div style=\"display: flex; align-items: center; gap: 12px;\">\n                        <svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"#3a0ca3\"><path d=\"M0 0h24v24H0z\" fill=\"none\"></path><path d=\"M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z\"></path></svg>\n                        <span style=\"font-weight: 600; font-size: 16px; color: var(--text-dark);\">Folder UPP — Google Drive</span>\n                    </div>\n                    <a href=\"https://drive.google.com/drive/folders/1EV7CnRuGbNM-h__eZUBQCtl4U6mUZpkX\" target=\"_blank\" style=\"background: var(--purple); color: white; padding: 6px 18px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 500; transition: background 0.2s;\" onmouseover=\"this.style.background='var(--purple-dark)'\" onmouseout=\"this.style.background='var(--purple)'\">Buka di Drive</a>\n                </div>\n                <div style=\"position: relative; width: 100%; background: var(--off